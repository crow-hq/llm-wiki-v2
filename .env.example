# llm-wiki-v2: copy to .env (never commit it) and set at least one provider key.
# Keys go to Bifrost (docker/bifrost/config.json); you can also add providers in its UI.

# Providers. Models are named "<provider>/<model>" (see OKF_LLM_MODEL).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
# Service-account JSON on one line. Leave empty only when Bifrost runs on Google Cloud
# (Application Default Credentials come from the metadata server, not from your laptop).
VERTEX_AUTH_CREDENTIALS=
# Only needed for the full-Bifrost classifier route below.
TYPESAFE_API_KEY=

# Wiki. classic = the LLM decides where notes go; crow = the typed classifier does.
OKF_MODE=classic
# e.g. openrouter/google/gemini-2.5-flash, gemini/gemini-2.5-flash, vertex/gemini-2.5-pro
OKF_LLM_MODEL=openrouter/google/gemini-2.5-flash
# Optional extra JSON for every LLM request, forwarded by Bifrost. OpenRouter provider pinning:
# OKF_LLM_EXTRA_BODY='{"provider":{"order":["together","coreweave"]}}'

# CROW classifier (Jev, System One API). Today it calls OpenRouter directly with
# OPENROUTER_API_KEY: Bifrost cannot route OpenRouter's System One endpoint yet
# (maximhq/bifrost#7415, custom-provider fix in PR #7448).
OKF_CLASSIFIER_BASE_URL=https://openrouter.ai/api/v1
OKF_CLASSIFIER_MODEL=typesafe/jev-1.13
# Full Bifrost: route it through Bifrost's native typesafe provider (set TYPESAFE_API_KEY):
# OKF_CLASSIFIER_BASE_URL=http://bifrost:8080/typesafe/v1
# Optional: classifier key when it is not OPENROUTER_API_KEY.
# OKF_CLASSIFIER_API_KEY=

# Host ports (change them if 8000/8080 are taken).
# OKF_PORT=8000
# BIFROST_PORT=8080
