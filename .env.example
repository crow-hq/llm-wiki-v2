# llm-wiki-v2 with Docker: copy to .env (never commit it), choose a provider, set its key.
# Without Docker you do not need this file: run `llmwiki2` and fill in the settings page,
# or `llmwiki2 setup` in the terminal.

# Provider: openrouter, openai, gemini, ollama or custom (any OpenAI-compatible server).
OKF_LLM_PROVIDER=openrouter
# Its key. OpenRouter's also serves the CROW classifier.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Model, as the provider names it. Empty: the provider's default (openrouter: google/gemini-3.8-flash).
OKF_LLM_MODEL=
# custom (vLLM, LM Studio, llama.cpp, a gateway): its address and, if it wants one, its key.
# From inside the container, a server on your machine is http://host.docker.internal:<port>/v1,
# Ollama included: OKF_LLM_PROVIDER=custom with OKF_LLM_BASE_URL=http://host.docker.internal:11434/v1.
# OKF_LLM_BASE_URL=http://host.docker.internal:8001/v1
# OKF_LLM_API_KEY=
# Optional extra JSON for every LLM request. OpenRouter provider pinning:
# OKF_LLM_EXTRA_BODY='{"provider":{"order":["together","coreweave"]}}'
# Thinking before answering: off by default (much faster); true turns it on (OpenRouter).
# OKF_LLM_REASONING=false

# Wiki. crow (default) = the typed classifier decides where notes go, with its own
# provider below; classic = the LLM decides, no second key needed.
OKF_MODE=crow

# CROW classifier (System One API), apart from the LLM: openrouter (default) or typesafe for
# Jev, laya for Laya on your machine (http://host.docker.internal:8001/v1 from the container,
# in OKF_CLASSIFIER_BASE_URL), or custom for any other server. Each starts from its own
# thresholds preset (docs/wiki/crow.md); OKF_TAU_* variables override them.
# Its key is OPENROUTER_API_KEY on openrouter, TYPESAFE_API_KEY on typesafe,
# unless you set another one in OKF_CLASSIFIER_API_KEY.
# OKF_CLASSIFIER_PROVIDER=openrouter
# TYPESAFE_API_KEY=
# OKF_CLASSIFIER_BASE_URL=http://host.docker.internal:9000/v1
# OKF_CLASSIFIER_API_KEY=
# Pinned (thresholds are calibrated on it); empty: the provider's default, typesafe/jev-1.13.
# OKF_CLASSIFIER_MODEL=typesafe/jev-1.13

# Host port (change it if 8000 is taken).
# OKF_PORT=8000
